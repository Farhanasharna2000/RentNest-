        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract 'token' from JSON response and set as Postman variable\r",
                  "let jsonData;\r",
                  "try {\r",
                  "    jsonData = pm.response.json();\r",
                  "    if (jsonData && jsonData.data.accessToken) {\r",
                  "        pm.collectionVariables.set('token', jsonData.data.accessToken);\r",
                  "        pm.test('Token variable is set', function () {\r",
                  "            pm.expect(pm.collectionVariables.get('token')).to.eql(jsonData.data.accessToken);\r",
                  "        });\r",
                  "    } else {\r",
                  "        pm.test('Token field is missing in response', function () {\r",
                  "            pm.expect(jsonData && jsonData.token, 'Token field exists').to.be.ok;\r",
                  "        });\r",
                  "    }\r",
                  "} catch (e) {\r",
                  "    pm.test('Response is valid JSON', function () {\r",
                  "        pm.expect.fail('Response is not valid JSON');\r",
                  "    });\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "//Admin\n// {\n//   \"email\": \"sharna@gmail.com\",\n//   \"password\": \"Password@123\"\n// }\n\n//Landlord\n// {\n//   \"email\": \"nondini@gmail.com\",\n//   \"password\": \"Password@123\"\n// }\n\n//Tenant\n{\n  \"email\": \"adrita@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
